# CMC EDU v2 — environment contract.
# Copy to `.env` (gitignored) and fill real values. `.env` MUST NEVER be committed.
# `scripts/env-check.sh` asserts required vars are present per NODE_ENV (fail-closed).
# Var names here MUST match what the code reads — keep in sync when code changes.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV="development"          # development | test | production
PORT="3000"
DISABLE_CRON="0"                # 1 to disable scheduled workers (worker runtime)

# ── Database (Prisma) ────────────────────────────────────────────────────────
# DATABASE_URL: privileged/migration-owner role (runs `prisma migrate deploy`,
#   creates the cmc_app role). APP_DATABASE_URL: unprivileged `cmc_app` role the
#   APP + tests connect as, so RLS policies actually apply (ADR 0042).
DATABASE_URL="postgresql://postgres:password@localhost:5432/cmc_edu?schema=public"
APP_DATABASE_URL="postgresql://cmc_app:password@localhost:5432/cmc_edu?schema=public"

# ── LMS session (parent/student bearer tokens) ──────────────────────────────
# REQUIRED in production — no dev-default is allowed. Generate:
#   openssl rand -base64 48
LMS_SESSION_SECRET=""
LMS_TOKEN_TTL_MS="3600000"      # 1h default

# ── Email transport ─────────────────────────────────────────────────────────
# Both providers active (product decision 2026-07-07):
#   Brevo = transactional (parent/student OTP, notifications)
#   Graph = internal (HR / payroll / notify) — shares the Entra app registration.
# EmailOutbox.transport ('brevo'|'graph') selects per row.
BREVO_API_KEY=""
EMAIL_MAX_ATTEMPTS="5"
# Microsoft Graph (client-credentials → /sendMail). GRAPH_TENANT_ID/GRAPH_CLIENT_ID
# share the same Entra app as staff SSO (ENTRA_* below) — set to the same values.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER_EMAIL=""            # default sender; per-purpose senders below
GRAPH_SENDER_HR=""
GRAPH_SENDER_NOTIFY=""
GRAPH_SENDER_PAYROLL=""

# ── Object storage (exercise PDFs, evidence) ────────────────────────────────
# Prod: S3-compatible (MinIO/R2/S3). Dev/UAT fallback: local disk (BLOB_STORAGE_DIR).
# Bucket MUST be private (no public ACL).
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
BLOB_STORAGE_DIR="./.blob-store" # local-disk fallback when S3_* absent

# ── LLM (AI assessment drafts) ──────────────────────────────────────────────
# OpenAI-compatible router. assertNoPii runs before every call (TL13 §5).
LLM_BASE_URL="https://router.clawcmc.io.vn/v1"
LLM_MODEL="ag/gemini-3.5-flash-low"
LLM_API_KEY=""                   # absent → deterministic offline stub

# ── Trusted proxy (IP attendance, resolveIp) ────────────────────────────────
# CIDRs of the reverse proxy(ies) in front of the API — XFF only trusted from these.
TRUSTED_PROXY_CIDRS=""

# ── Staff auth: Microsoft Entra SSO (docs/18) ───────────────────────────────
# REQUIRED for staff ERP login in production (x-dev-user is disabled in prod).
SSO_ENABLED="false"              # flip true once SSO implemented (P3)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ERP_SSO_REDIRECT_URI="http://localhost:3000/auth/callback"
STAFF_EMAIL_DOMAIN=""            # restrict SSO logins to this domain

# ── Web origins ─────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173"
ADMIN_APP_ORIGIN="http://localhost:5173"

# ── Seed (first super_admin) ────────────────────────────────────────────────
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# ── Test-only ────────────────────────────────────────────────────────────────
TEST_OTP_SEAM=""                 # "1" exposes OTP in responses (NEVER in production)
