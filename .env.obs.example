# GlitchTip self-host env template (observability Tier 1).
# Copy to .env.obs and fill the secrets. NEVER commit .env.obs (gitignored).
# Used by docker-compose.observability.yml (project cmcv2-obs). Runs on the
# laptop next to the app so error data — which can carry student PII — stays local.
#
# One-time bring-up:
#   cp .env.obs.example .env.obs   # then fill the CHANGE_ME values
#   docker compose -p cmcv2-obs --env-file .env.obs -f docker-compose.observability.yml up -d
#   open http://127.0.0.1:8000/register  -> create first user + org + project
#   copy the project DSN into .env.prod  SENTRY_DSN=
#   claude mcp add --transport http glitchtip http://127.0.0.1:8000/mcp

# Postgres (GlitchTip's own DB, isolated from the app's cmcv2-prod DB)
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
DATABASE_URL=postgres://glitchtip:CHANGE_ME_STRONG_PG_PASSWORD@glitchtip-postgres:5432/glitchtip

# Django secret — any long random string:  openssl rand -base64 48
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Cache / celery broker (valkey is redis-compatible; GlitchTip reads REDIS_URL)
REDIS_URL=redis://glitchtip-valkey:6379/0

# Web
PORT=8080
GLITCHTIP_DOMAIN=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=glitchtip@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# UAT sizing / behaviour
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
CELERY_WORKER_AUTOSCALE=1,3
ENABLE_ORGANIZATION_CREATION=true
