# .env.prod.example — copy to .env.prod and fill all values before deploy.
# NEVER commit .env.prod to git. Add to .gitignore.
# All secrets must be injected via this file or a secret manager — never hardcoded.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_SUPERUSER_PASSWORD

# Migration role (DATABASE_URL) — used by prisma migrate deploy only.
# Must match POSTGRES_USER/PASSWORD above for the initial deploy.
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PG_SUPERUSER_PASSWORD@postgres:5432/cmc_prod?schema=public

# Application role (APP_DATABASE_URL) — unprivileged; RLS applies.
# Created by the p1_remediation_wave1_schema_rls migration.
APP_DATABASE_URL=postgresql://cmc_app:CHANGE_ME_CMC_APP_PASSWORD@postgres:5432/cmc_prod?schema=public

# ── LMS session signing (RT-1) ────────────────────────────────────────────────
# Minimum 32 cryptographically random characters. Generate with:
#   openssl rand -base64 48
LMS_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS

# ── Staff session cookie signing (S2) ─────────────────────────────────────────
# Separate from LMS secret — MUST NOT reuse the same value. Generate:
#   openssl rand -base64 48
STAFF_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS_DIFFERENT_FROM_LMS

# ── Microsoft Entra SSO (staff auth) ─────────────────────────────────────────
# Set SSO_ENABLED=true once Azure app registration is configured.
SSO_ENABLED=true
ENTRA_TENANT_ID=CHANGE_ME
ENTRA_CLIENT_ID=CHANGE_ME
ENTRA_CLIENT_SECRET=CHANGE_ME
ERP_SSO_REDIRECT_URI=https://CHANGE_ME_YOUR_DOMAIN/auth/callback
STAFF_EMAIL_DOMAIN=CHANGE_ME_YOUR_DOMAIN   # e.g. cmcedu.vn — leave empty to allow all Entra users

# ── Web origins ───────────────────────────────────────────────────────────────
CORS_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN
ADMIN_APP_ORIGIN=https://CHANGE_ME_YOUR_DOMAIN

# ── Email transport ───────────────────────────────────────────────────────────
# Brevo (transactional: parent/student OTP, notifications)
BREVO_API_KEY=CHANGE_ME

# Graph / M365 (internal: HR, payroll, notify — shares the Entra app)
GRAPH_TENANT_ID=CHANGE_ME   # same as ENTRA_TENANT_ID
GRAPH_CLIENT_ID=CHANGE_ME   # same as ENTRA_CLIENT_ID
GRAPH_CLIENT_SECRET=CHANGE_ME   # same as ENTRA_CLIENT_SECRET
GRAPH_SENDER_EMAIL=no-reply@CHANGE_ME_YOUR_DOMAIN
GRAPH_SENDER_HR=hr@CHANGE_ME_YOUR_DOMAIN
GRAPH_SENDER_NOTIFY=notify@CHANGE_ME_YOUR_DOMAIN
GRAPH_SENDER_PAYROLL=payroll@CHANGE_ME_YOUR_DOMAIN

# ── Object storage ────────────────────────────────────────────────────────────
# For MinIO (compose --profile minio):
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cmc-blobs
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# MinIO root credentials (only used when profile minio is active)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ── LLM (AI draft assessment) ─────────────────────────────────────────────────
LLM_API_KEY=CHANGE_ME
LLM_MODEL=claude-haiku-4-5-20251001

# ── Backup — OFF-BOX target (RT-13) ──────────────────────────────────────────
# Must be a DIFFERENT host/provider from this VPS. External S3/R2/Backblaze.
# scripts/backup-db.sh reads these vars.
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=cmc-db-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
# Retention: how many days to keep backups before pruning (default 30).
BACKUP_KEEP_DAYS=30

# Dump encryption passphrase (AES-256-CBC via openssl).
# MUST also be stored in your team password manager (escrow — machine-independent recovery).
# Generate: openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_BACKUP_ENCRYPTION_PASSPHRASE

# Explicit acknowledgment that the R2 bucket blocks public access.
# Verify: Cloudflare Dashboard → R2 → <bucket> → Settings → Public Access = Disabled.
# Then change the value below to: true
BACKUP_BUCKET_PRIVATE_CONFIRMED=CHANGE_ME_SET_TO_true_AFTER_CF_DASHBOARD_VERIFIED

# ── Worker tuning ─────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=30000
WORKER_HEALTH_PORT=3001
EMAIL_MAX_ATTEMPTS=5

# ── Trusted proxy (RT-5) ─────────────────────────────────────────────────────
# CIDRs of the reverse proxy(ies) in front of the API. Default Docker bridge range:
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32

# ── Seed (first super_admin — used by prisma db seed) ────────────────────────
SEED_SUPERADMIN_EMAIL=CHANGE_ME_SUPERADMIN_EMAIL
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD

# ── DO NOT SET ────────────────────────────────────────────────────────────────
# The following must NEVER appear in .env.prod (boot-check refuses start):
# ALLOW_DEV_AUTH=1
# TEST_OTP_SEAM=1
