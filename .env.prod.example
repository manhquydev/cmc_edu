# .env.prod.example — copy to .env.prod and fill all values before deploy.
# NEVER commit .env.prod to git. Add to .gitignore.
# All secrets must be injected via this file or a secret manager — never hardcoded.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_SUPERUSER_PASSWORD

# Migration role (DATABASE_URL) — used by prisma migrate deploy only.
# Must match POSTGRES_USER/PASSWORD above for the initial deploy.
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PG_SUPERUSER_PASSWORD@postgres:5432/cmc_prod?schema=public

# Application role (APP_DATABASE_URL) — unprivileged; RLS applies.
# Created by the p1_remediation_wave1_schema_rls migration.
APP_DATABASE_URL=postgresql://cmc_app:CHANGE_ME_CMC_APP_PASSWORD@postgres:5432/cmc_prod?schema=public

# ── LMS session signing (RT-1) ────────────────────────────────────────────────
# Minimum 32 cryptographically random characters. Generate with:
#   openssl rand -base64 48
LMS_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS

# ── Microsoft Entra SSO (staff auth) ─────────────────────────────────────────
ENTRA_TENANT_ID=CHANGE_ME
ENTRA_CLIENT_ID=CHANGE_ME
ENTRA_CLIENT_SECRET=CHANGE_ME

# ── Email transport (pick one) ────────────────────────────────────────────────
# Brevo (recommended)
BREVO_API_KEY=CHANGE_ME

# Graph / M365 (optional, alongside Brevo)
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME
GRAPH_SENDER_UPN=no-reply@yourdomain.com

# ── Object storage ────────────────────────────────────────────────────────────
# For MinIO (compose --profile minio):
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cmc-blobs
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# MinIO root credentials (only used when profile minio is active)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ── LLM (AI draft assessment) ─────────────────────────────────────────────────
LLM_API_KEY=CHANGE_ME
LLM_MODEL=claude-haiku-4-5-20251001

# ── Backup — OFF-BOX target (RT-13) ──────────────────────────────────────────
# Must be a DIFFERENT host/provider from this VPS. External S3/R2/Backblaze.
# scripts/backup-db.sh reads these vars.
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=cmc-db-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME

# ── Worker tuning ─────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=30000
WORKER_HEALTH_PORT=3001
EMAIL_MAX_ATTEMPTS=5

# ── DO NOT SET ────────────────────────────────────────────────────────────────
# The following must NEVER appear in .env.prod (boot-check refuses start):
# ALLOW_DEV_AUTH=1
