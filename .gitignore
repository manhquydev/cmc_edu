# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.turbo/
.vite/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# @cmc/storage local-disk dev blobs (LocalDiskBlobStorage default dir)
.data/

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.npmrc
!.npmrc.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager (pnpm is the workspace lockfile — commit it for reproducible installs)
package-lock.json
yarn.lock

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example
# Same secrets without the leading dot; `.env*` above does not cover these
/env
/env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
# Plans and reports are durable development context. Track Markdown so a fresh
# clone preserves execution history; continue ignoring binary/runtime evidence.
/plans/**
!/plans/
!/plans/**/
!/plans/**/*.md
screenshots/*
docs/screenshots/*
logs.txt
scan_summary.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# Generated ClaudeKit runtime layout. Keep only project-level rules portable.
/.claude/*
!/.claude/.env.example
!/.claude/rules/
!/.claude/rules/**

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Grok CLI local settings
/.grok/

# Nested Claude Code session artifacts (e.g. apps/api/.claude/agent-memory)
**/.claude/agent-memory/

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/
# Gemini CLI settings (contains user-specific config)
.gemini/

# GitNexus knowledge-graph index (local, ~20MB binary)
.gitnexus/

# Harness durable layer
harness.db
harness.db-wal
harness.db-shm
scripts/bin/harness-cli
scripts/bin/harness-cli.exe
scripts/bin/harness-symphony
scripts/bin/harness-symphony.exe

# Harness Symphony local runtime state (do not commit)
.symphony/
# Per-run artifacts (SUMMARY/RESULT/CONTRACT); only changesets are durable
.harness/runs/
# Epoch-transition writer lock (runtime state from harness-cli >= 0.1.17)
.harness/epoch-transition/
# Installer and manual pre-upgrade backups (never commit)
.harness-backup/
.harness-preupgrade-backup-*/
# Harness core runtime state; manifest.json and base/ stay tracked so a fresh
# clone can still run `harness update`
.harness-core/lock
.harness-core/transaction.json

# Test coverage artifacts
coverage/
**/coverage/

# Playwright e2e artifacts
apps/e2e/test-results/
apps/e2e/playwright-report/
apps/e2e/playwright/.cache/

# Machine evidence the acceptance ledger ingests (UI runs only). Kept OUT of
# test-results/ on purpose: Playwright clears that directory at the start of
# every run, so an API-only run would delete the UI evidence. Never committed —
# a checked-in copy would be a hand-editable file claiming to be a run result.
apps/e2e/acceptance-results/

# Acceptance ledger tool output (screenshots/JSON regenerated on demand — never commit).
# Anchored to repo root — a bare "acceptance-report/" would also match
# scripts/acceptance-report/ (the tool's own source code) and hide it from git.
/acceptance-report/

# Offline presentation deck output (generated by pnpm deck:build — never commit)
/presentation-deck/

# Harness core maintenance binary
scripts/bin/harness
scripts/bin/harness.exe

# Local-sim TLS material (self-signed, never commit keys)
infra/nginx/certs/

# Local-sim demo credentials (generated, never commit)
.env.local-sim-accounts

# Playwright MCP transient debug logs
.playwright-mcp/

# Session analysis artifacts (screenshots + scan output) — not source code
/*.png
/codeql-agent-results/
/cockpit-gdkd-snapshot.md

# deck build staging (ephemeral)
.presentation-deck-staging/

# Local nodeterm canvas state (machine-specific)
.nodeterm/

# Authenticated/e2e screenshot dumps (plan 260807-1453 prereq)
outputs/
