{
  "name": "@cmc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:start": "node dist/worker/index.js"
  },
  "dependencies": {
    "@cmc/auth": "workspace:*",
    "@cmc/db": "workspace:*",
    "@cmc/domain-finance": "workspace:*",
    "@cmc/domain-identity": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
