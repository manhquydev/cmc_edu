# syntax=docker/dockerfile:1
# Admin frontend (Vite SPA) — builds static assets served by nginx.
# Build context: repo root (docker build -f infra/docker/Dockerfile.admin .)

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable pnpm
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/admin/package.json apps/admin/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/admin/ apps/admin/
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# SSO UI flag: VITE_SSO_ENABLED=true shows the Microsoft login button.
# VITE_API_URL overrides the API base for the /auth/* redirect target.
ARG VITE_SSO_ENABLED=false
ENV VITE_SSO_ENABLED=${VITE_SSO_ENABLED}
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm --filter @cmc/admin run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html/admin
COPY infra/nginx/spa-fallback.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
