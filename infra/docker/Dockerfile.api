# syntax=docker/dockerfile:1
# API tRPC server — production image.
# Build context: repo root (docker build -f infra/docker/Dockerfile.api .)

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable pnpm
WORKDIR /app

# --- dependency layer (cache-friendly: only package manifests) ---
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/auth/package.json         packages/auth/
COPY packages/db/package.json           packages/db/
COPY packages/domain-payroll/package.json packages/domain-payroll/
COPY packages/domain-time/package.json  packages/domain-time/
COPY packages/llm/package.json          packages/llm/
COPY packages/storage/package.json      packages/storage/
COPY apps/api/package.json              apps/api/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# --- build layer ---
FROM deps AS build
COPY packages/ packages/
COPY apps/api/ apps/api/
# Generate Prisma client (schema lives in packages/db/prisma/)
RUN pnpm --filter @cmc/db exec prisma generate
RUN pnpm --filter @cmc/api run build

# --- runtime layer (minimal) ---
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable pnpm
WORKDIR /app

COPY --from=build /app/package.json          ./package.json
COPY --from=build /app/pnpm-lock.yaml        ./pnpm-lock.yaml
COPY --from=build /app/pnpm-workspace.yaml   ./pnpm-workspace.yaml
COPY --from=build /app/node_modules          ./node_modules
COPY --from=build /app/packages              ./packages
COPY --from=build /app/apps/api/dist         ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json

WORKDIR /app/apps/api
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "dist/server.js"]
