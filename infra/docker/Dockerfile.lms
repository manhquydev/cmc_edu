# syntax=docker/dockerfile:1
# LMS frontend (Vite SPA) — builds static assets served by nginx.
# Build context: repo root (docker build -f infra/docker/Dockerfile.lms .)
# Needs api sources at build time: lms type-imports AppRouter from
# apps/api (tRPC client typing), which in turn needs the generated Prisma client.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable pnpm
WORKDIR /app

# pnpm --frozen-lockfile validates the lockfile against EVERY workspace
# importer, so all workspace package.json manifests must be present.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/auth/package.json            packages/auth/
COPY packages/db/package.json              packages/db/
COPY packages/domain-finance/package.json  packages/domain-finance/
COPY packages/domain-grading/package.json  packages/domain-grading/
COPY packages/domain-identity/package.json packages/domain-identity/
COPY packages/domain-payroll/package.json  packages/domain-payroll/
COPY packages/domain-time/package.json     packages/domain-time/
COPY packages/llm/package.json             packages/llm/
COPY packages/mcp-server/package.json      packages/mcp-server/
COPY packages/storage/package.json         packages/storage/
COPY packages/ui/package.json              packages/ui/
COPY apps/api/package.json                 apps/api/
COPY apps/admin/package.json               apps/admin/
COPY apps/lms/package.json                 apps/lms/
COPY apps/e2e/package.json                 apps/e2e/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/lms/ apps/lms/
# prisma.config.ts loads packages/db/prisma/.env and requires DATABASE_URL to
# resolve (Prisma 7 config validation) — `generate` never opens a connection,
# so a build-time-only placeholder is enough (mirrors CI's ui-e2e.yml, which
# writes the real value; here any syntactically valid postgres URL works).
RUN printf 'DATABASE_URL=postgresql://build:build@localhost:5432/build\n' > packages/db/prisma/.env
RUN pnpm --filter @cmc/db exec prisma generate
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# apps/lms/src/lib/trpc.ts and session-evidence.tsx read VITE_API_URL (not
# VITE_API_BASE_URL above, which is unused dead config in this app) for the
# tRPC base URL. Empty default = relative same-origin requests through nginx,
# matching Dockerfile.admin's pattern.
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
# `@cmc/lms...` builds workspace dependencies (ui/auth/api chain) first.
RUN pnpm --filter @cmc/lms... run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/lms/dist /usr/share/nginx/html/lms
# spa-fallback.conf (generic) falls back to /index.html at the server root,
# which does not exist here — dist is under /lms. That breaks client-side
# routing on any deep link or page refresh. spa-fallback-lms.conf falls back
# to /lms/index.html instead, matching where the bundle actually is.
COPY infra/nginx/spa-fallback-lms.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
