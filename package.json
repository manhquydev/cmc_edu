{
  "name": "cmc-edu-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@cmc/e2e",
    "dev": "turbo run dev",
    "lint": "eslint apps/admin apps/lms scripts",
    "acceptance:report": "tsx scripts/acceptance-report/verify.ts",
    "business:verify": "tsx scripts/business-verify/verify.ts",
    "deck:build": "tsx scripts/presentation/build.ts",
    "deck:check": "tsx scripts/presentation/check-copy.ts",
    "test:deck": "vitest run --config scripts/presentation/vitest.config.ts",
    "verify:portability": "node scripts/verify-repository-portability.mjs",
    "check:ui-frames": "node scripts/check-ui-frames.mjs --strict",
    "test:ui-frames": "node --test scripts/check-ui-frames.test.mjs",
    "check:ui-a11y-roles": "node scripts/check-ui-a11y-roles.mjs",
    "test:ui-a11y-roles": "node --test scripts/check-ui-a11y-roles.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "eslint-formatter-compact": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "reveal.js": "5.2.1",
    "ts-morph": "^24.0.0",
    "tsx": "^4.23.5",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "fast-uri": "^3.1.4",
      "minimatch@9>brace-expansion": "^2.1.3",
      "brace-expansion": "^5.0.8",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "hono": "^4.12.34"
    }
  },
  "lint-staged": {
    "apps/{admin,lms}/**/*.{ts,tsx}": "eslint --no-warn-ignored --max-warnings=0"
  }
}
