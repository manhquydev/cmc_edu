{
  "name": "@cmc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.0.0",
    "typescript": "^6.0.0"
  }
}
