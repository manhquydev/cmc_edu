// @cmc/db — Prisma schema.
//
// P1 substrate (identity · enrollment): adds the Contact→Opportunity→Receipt
// money-gate chain, Student/ParentAccount/Guardian identity, and Enrollment.
// No business logic lives here — only the data shape + invariants documented
// inline. Source of truth: docs/10-data-model-v2.md, docs/16 (ADR-A/B),
// docs/22 (ADR 0041).
//
// Scope notes (P1 substrate, not yet modeled):
// - `AppUser`/staff identity arrives with the HR/identity phase. Until then,
//   `Receipt.createdById`/`approvedById` and `ClassBatch.createdById`/
//   `ClassBatch.teacherId` are plain uuid scalars (no FK) — they reference the
//   dev-session `userId` from `apps/api/src/context.ts`.
// - `ParentAccount`/`StudentAccount`/`LoginOtp` are identity models whose
//   uniqueness (`phone`) spans the whole system, not one facility — they are
//   intentionally NOT facility-scoped (TL10 §4 invariant #3).
//
// P2-Foundation (class operations, docs/26 WF-P2-01, QĐ 0036, ADR 0042):
// - `Course`/`Room`/`ClassBatch`/`ScheduleSlot`/`ClassSession` are the class
//   data model. `Receipt.classBatchId` is now a real (nullable) FK;
//   `Enrollment.classBatchId` is now a real (required) FK — both were plain
//   scalars in P1.
// - `Facility.code` (added this phase) is the `{facility.code}` component of
//   the class-code format (QĐ 0036, e.g. `HN-UCREA-2026-001`) — P1 had no
//   such field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OpportunityStage {
  O1_LEAD
  O2_CONTACTED
  O3_TEST_SCHEDULED
  O4_TESTED
  O5_ENROLLED
}

/// Minimal representative set (docs do not enumerate the full catalog for P1).
enum LostReason {
  no_response
  price_too_high
  chose_competitor
  schedule_conflict
  not_interested
  other
}

enum ReceiptStatus {
  draft
  approved
  sent
  cancelled
}

enum ReceiptKind {
  new
  renewal
}

/// ADR-A (docs/16): `reserved` = held, not fee-activated. `active` = has an
/// approved Receipt (Receipt-driven; never set by hand). Do NOT add
/// `pending_payment` — payment is tracked by Receipt, not by this enum.
enum EnrollmentStatus {
  reserved
  active
  completed
  transferred
  withdrawn
}

enum GuardianRelation {
  father
  mother
  guardian
}

enum GuardianLinkStatus {
  pending
  approved
  rejected
}

/// Gates LMS surfaces (ADR 0038 references `BLOCKED_LMS_LIFECYCLE`-style gating).
enum StudentLifecycle {
  active
  blocked_lms
  withdrawn
}

enum LoginOtpStatus {
  pending
  verified
  expired
}

enum EmailTransport {
  graph
  brevo
}

/// Curriculum program catalog (docs/19 §1). Fixed 3-value set — no ADR to add
/// a 4th without a decision doc.
enum Program {
  UCREA
  BRIGHT_IG
  BLACK_HOLE
}

/// ClassSession lifecycle (docs/26 WF-P2-01). `cancelled` sessions are
/// excluded from attendance (docs/19 §5) — enforced in the P2-Teaching phase,
/// not here.
enum SessionStatus {
  planned
  confirmed
  cancelled
}

/// T1 attendance (docs/19 §5, WF-P2-02). Fixed 3-value set per spec.
enum AttendanceStatus {
  present
  absent
  late
}

/// Curriculum unit type (docs/19 §1, T2-I). Fixed 2-value set per spec.
enum UnitType {
  LESSON
  REVIEW
}

/// Exercise kind (docs/19 §3, T2-I). Fixed 3-value set per spec.
enum ExerciseType {
  homework
  test_entrance
  test_periodic
}

/// Exercise lifecycle (docs/19 §3, WF-P2-04). `published` = visible to
/// students per the ADR 0038 open-tier gate (T2-II, not this phase).
enum ExerciseStatus {
  draft
  published
  closed
}

/// Submission lifecycle (docs/19 §3, WF-P2-05, T2-II). `draft` = student is
/// still editing (re-saves increment `version`); `submitted` = immutable,
/// awaiting grading; `graded` = GV has scored it (may be re-graded, but never
/// reverts to `submitted`/`draft`).
enum SubmissionStatus {
  draft
  submitted
  graded
}

/// Star ledger entry kind (docs/19 §6, WF-P2-06, T2-II). Fixed 4-value set per
/// phase-03 spec — `gift_redeemed`/`gift_rejected_refund`/`manual` are not
/// exercised by this phase's procedures (no gift-catalog story yet) but are
/// part of the documented enum contract for the later rewards phase.
enum StarTxnType {
  homework_completed
  gift_redeemed
  gift_rejected_refund
  manual
}

enum EmailOutboxStatus {
  pending
  /// R3 remediation (deep-review adversarial verification): a transient claim
  /// state between `pending`/`failed` and `sent`/`failed` — a row sits here
  /// only for the duration of one `relayEmailOutbox` send attempt, so two
  /// concurrent worker replicas draining the same outbox can never both send
  /// the same row (see relay-email-outbox.ts's atomic `updateMany` claim).
  sending
  sent
  failed
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Facility {
  id        String   @id @default(uuid())
  name      String
  /// P2-Foundation addition (QĐ 0036): the `{facility.code}` component of the
  /// class-code format (e.g. `HN` in `HN-UCREA-2026-001`). Unique system-wide.
  /// `facility.create` auto-derives one from `name` when the caller omits it
  /// (see apps/api/src/facility/router.ts), so no P1 caller needs updating.
  code      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// P3-I back-relations — added when AppUser/FacilityNetwork/TimePunch/
  /// ManualAttendanceTicket were introduced (P3-I HR/identity phase).
  appUsers        AppUser[]
  facilityNetworks FacilityNetwork[]
  timePunches     TimePunch[]
  manualTickets   ManualAttendanceTicket[]
}

model Contact {
  id            String        @id @default(uuid())
  facilityId    String
  name          String
  phone         String
  email         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  opportunities Opportunity[]

  @@index([facilityId])
}

model Opportunity {
  id         String           @id @default(uuid())
  facilityId String
  contactId  String
  stage      OpportunityStage @default(O1_LEAD)
  lostReason LostReason?
  closedAt   DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  contact  Contact   @relation(fields: [contactId], references: [id])
  receipts Receipt[]

  @@index([facilityId])
  @@index([contactId])
}

/// One row per facility; `value` is the last-issued sequence number.
/// `nextReceiptCode` (packages/domain-finance) formats `value + 1`.
///
/// NOTE (RLS, ADR 0042): despite the `facilityId` column name, the current
/// implementation (apps/api/src/finance/router.ts) keys every row by a
/// GLOBAL sentinel constant (`GLOBAL_RECEIPT_CODE_COUNTER_KEY`), never a real
/// facility id — `Receipt.code` is unique system-wide, not per facility.
/// Postgres RLS is intentionally NOT enabled on this table: a per-facility
/// `current_setting('app.current_facility_id')` policy would reject the
/// sentinel-keyed row and break every receipt creation. Treat this table as
/// global infrastructure, like `AuditLog`/`ParentAccount`.
model ReceiptCodeCounter {
  id         String   @id @default(uuid())
  facilityId String   @unique
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([facilityId])
}

model Receipt {
  id            String        @id @default(uuid())
  facilityId    String
  code          String        @unique
  /// Frozen after approval (TL10 §4 invariant #2); SUM(RefundRecord.amount) <= netAmount.
  netAmount     Decimal       @db.Decimal(14, 2)
  status        ReceiptStatus @default(draft)
  kind          ReceiptKind   @default(new)
  opportunityId String?
  /// Provenance for renewal reuse (H3 remediation): the Student this receipt
  /// belongs to, when known at creation time. Nullable — the renewal-reuse
  /// write path (reusing an existing Student instead of provisioning a new
  /// one) lands in the next remediation wave; this column only holds the
  /// shape for it.
  studentId     String?
  parentPhone   String
  studentName   String
  /// P2-Foundation: real (nullable) FK — WF-P2-05 "seam", `finance.receiptCreate`
  /// validates this points at a ClassBatch in the caller's facility (app-level
  /// NOT_FOUND check); nullable at the schema level only because `Receipt`
  /// predates `ClassBatch` (migration safety), not because the app allows it.
  classBatchId  String?
  /// Plain scalar — references AppUser.id (arrives with the HR/identity phase).
  approvedById  String?
  /// Plain scalar — references AppUser.id (arrives with the HR/identity phase).
  createdById   String
  /// P3-I: real FK to AppUser (nullable — backfill; old rows keep plain scalar).
  createdByAppUserId  String?
  approvedByAppUserId String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id])
  classBatch        ClassBatch?    @relation(fields: [classBatchId], references: [id])
  refunds           RefundRecord[]
  student           Student?
  createdByAppUser  AppUser?       @relation("ReceiptCreatedBy", fields: [createdByAppUserId], references: [id])
  approvedByAppUser AppUser?       @relation("ReceiptApprovedBy", fields: [approvedByAppUserId], references: [id])

  @@index([facilityId])
  @@index([facilityId, parentPhone])
  @@index([opportunityId])
  @@index([classBatchId])
}

/// Append-only ledger: corrections are new rows, never edits (TL10 §4).
model RefundRecord {
  id         String   @id @default(uuid())
  receiptId  String
  /// M5 remediation: the money ledger must be facility-scoped for RLS
  /// (defense-in-depth, ADR 0042) — denormalized from `Receipt.facilityId` at
  /// write time (see finance/router.ts `runRefundTransaction`).
  facilityId String
  amount     Decimal  @db.Decimal(14, 2)
  /// M4 remediation (docs/11 §4 idempotency): caller-supplied key. A repeat
  /// `refundCreate` call with the same (receiptId, idempotencyKey) returns
  /// the existing row instead of appending a duplicate. Nullable — refunds
  /// created without a key are never deduped against each other (Postgres
  /// unique indexes treat each NULL as distinct).
  idempotencyKey String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  receipt Receipt @relation(fields: [receiptId], references: [id])

  @@unique([receiptId, idempotencyKey])
  @@index([receiptId])
  @@index([facilityId])
}

model Student {
  id         String           @id @default(uuid())
  facilityId String
  fullName   String
  /// Provenance: the Receipt whose approval provisioned this student. Nullable
  /// only for break-glass admin creation (separate admin surface, ADR 0041);
  /// application logic must not create "orphan" students outside that path.
  createdByReceiptId String?  @unique
  lifecycle           StudentLifecycle @default(active)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  createdByReceipt      Receipt?               @relation(fields: [createdByReceiptId], references: [id])
  enrollments           Enrollment[]
  guardians             Guardian[]
  studentAccount        StudentAccount?
  attendances           Attendance[]
  submissions           Submission[]
  finalGrades           FinalGrade[]
  starTransactions      StarTransaction[]
  qualitativeAssessments QualitativeAssessment[]

  @@index([facilityId])
}

/// Login identity for parents. `phone` is unique system-wide (find-or-create
/// provisioning target — TL10 §4 invariant #3), not facility-scoped.
model ParentAccount {
  id                   String                @id @default(uuid())
  phone                String                @unique
  passwordHash         String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  studentAccounts      StudentAccount[]
  guardians            Guardian[]
  guardianLinkRequests GuardianLinkRequest[]
}

/// One row per Student's LMS login, owned by the ParentAccount that
/// provisioned it (finance.receiptApprove auto-provisioning — ADR 0041).
model StudentAccount {
  id              String   @id @default(uuid())
  studentId       String   @unique
  parentAccountId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  student       Student       @relation(fields: [studentId], references: [id])
  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id])

  @@index([parentAccountId])
}

/// Approved guardian↔student relationship (staff-approved, see GuardianLinkRequest).
///
/// NOTE (RLS, ADR 0042): carries `facilityId` (used by the staff-side
/// `guardian.approveLink`/`rejectLink` app-level `scoped()` filter) but
/// Postgres RLS is intentionally NOT enabled here. The LMS parent-facing read
/// path (`getApprovedChildren`) legitimately spans facilities — a parent's
/// children may be enrolled at different branches — and is gated by
/// `parentAccountId` ownership (an approved Guardian row), not by facility,
/// mirroring the ParentAccount/StudentAccount identity exemption.
///
/// T3 (C2, TL08 §7): `photoConsent` = whether this parent has consented to
/// photos of their child being shared via session evidence. Revocation is
/// captured by `photoConsentRevokedAt` — consent is active only when
/// `photoConsent = true AND photoConsentRevokedAt IS NULL`. UI-level tagging
/// of which children appear in which photo is a deferred concern (decision
/// note in phase-04 spec); this gate is the mandatory data-minimisation floor.
model Guardian {
  id                     String           @id @default(uuid())
  facilityId             String
  parentAccountId        String
  studentId              String
  relation               GuardianRelation
  /// C2 (TL08 §7): has this parent consented to photos of their child being
  /// shared in session evidence? Default false — opt-in, not opt-out.
  photoConsent           Boolean          @default(false)
  /// Set when photoConsent is granted (the instant, not just the date).
  photoConsentAt         DateTime?        @db.Timestamptz(3)
  /// Set when consent is revoked; photos are hidden immediately on revocation.
  photoConsentRevokedAt  DateTime?        @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])

  @@index([facilityId])
  @@unique([parentAccountId, studentId])
}

/// A parent's self-service request to link to a student, pending staff review
/// (`guardian.approveLink`). `studentRef` is the raw input the parent supplied
/// (e.g. student code) — resolved to a `Guardian` row only on approval.
///
/// NOTE (RLS, ADR 0042): same exemption as `Guardian` above — the parent
/// creates this row before any facility session exists (`requestLink` is an
/// `lmsProcedure`), so it cannot be gated by a single facility GUC.
model GuardianLinkRequest {
  id              String             @id @default(uuid())
  facilityId      String
  parentAccountId String
  studentRef      String
  status          GuardianLinkStatus @default(pending)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id])

  @@index([facilityId])
  @@index([parentAccountId])
}

/// Two-step lifecycle, Receipt-driven (ADR-A): `enrollment.enroll` creates
/// `reserved`; `finance.receiptApprove` flips it to `active`. Never set by hand.
///
/// H2 remediation: a hand-edited partial unique index
/// (`enrollment_active_reserved_unique` — see the migration SQL, not
/// representable as a Prisma `@@unique` because Postgres partial indexes take
/// a `WHERE` clause) enforces at most one `reserved`/`active` row per
/// (facilityId, studentId, classBatchId), while still allowing re-enrollment
/// after `withdrawn`/`completed`.
model Enrollment {
  id         String           @id @default(uuid())
  facilityId String
  studentId  String
  /// P2-Foundation: real (required) FK — the WF-P2-05 "seam", `enrollment.enroll`
  /// validates this points at a ClassBatch in the caller's facility
  /// (app-level NOT_FOUND check) before the DB FK constraint is even reached.
  classBatchId String
  status       EnrollmentStatus @default(reserved)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  student    Student    @relation(fields: [studentId], references: [id])
  classBatch ClassBatch @relation(fields: [classBatchId], references: [id])
  attendances Attendance[]

  @@index([facilityId])
  @@index([studentId])
  @@index([classBatchId])
}

// ---------------------------------------------------------------------------
// P2-Foundation — class operations (docs/26 WF-P2-01, TL19 §1-2, QĐ 0036).
// ---------------------------------------------------------------------------

/// Curriculum "khoá học" catalog (minimal — TL19 §1 defers the full
/// level×month structure to a later curriculum phase). Facility-scoped, RLS.
model Course {
  id         String   @id @default(uuid())
  facilityId String
  program    Program
  name       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  classBatches ClassBatch[]

  @@index([facilityId])
}

/// Physical room, used for the room+time double-booking check
/// (`classBatch.create` CONFLICT). Facility-scoped, RLS.
model Room {
  id         String   @id @default(uuid())
  facilityId String
  code       String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  classBatches ClassBatch[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

/// A running class ("lớp"). `code` is unique per facility (QĐ 0036:
/// `{facility.code}-{program}-{year}-{seq}`, atomic per facility+program+year
/// via `ClassBatchCodeCounter`). Facility-scoped, RLS.
model ClassBatch {
  id         String   @id @default(uuid())
  facilityId String
  code       String
  courseId   String
  program    Program
  startDate  DateTime @db.Timestamptz(3)
  endDate    DateTime @db.Timestamptz(3)
  roomId     String?
  /// Plain scalar — references AppUser.id (arrives with the HR/identity phase).
  teacherId  String?
  /// No dedicated enum (YAGNI — the spec names only `Program`/`SessionStatus`
  /// as new enums this phase): `active` while the batch is running, `closed`
  /// once it ends. Not exercised by any P2-Foundation procedure yet.
  status      String   @default("active")
  /// Plain scalar — references AppUser.id (dev-session `userId`).
  createdById String
  /// P3-I: real FK to AppUser (nullable — backfill; old rows keep plain scalar).
  teacherAppUserId    String?
  createdByAppUserId  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  course           Course         @relation(fields: [courseId], references: [id])
  room             Room?          @relation(fields: [roomId], references: [id])
  scheduleSlots    ScheduleSlot[]
  classSessions    ClassSession[]
  enrollments      Enrollment[]
  receipts         Receipt[]
  finalGrades      FinalGrade[]
  teacherAppUser   AppUser?       @relation("ClassBatchTeacher", fields: [teacherAppUserId], references: [id])
  createdByAppUser AppUser?       @relation("ClassBatchCreatedBy", fields: [createdByAppUserId], references: [id])

  @@unique([facilityId, code])
  @@index([facilityId])
  @@index([courseId])
  @@index([roomId])
}

/// The weekly recurring schedule pattern a `ClassBatch` is generated from
/// (e.g. "Mon/Wed/Fri 18:00-19:30"). `startTime`/`endTime` are wall-clock
/// `HH:mm` (ICT) — there is no single calendar date to attach a timestamptz
/// to for a recurring weekly slot; `ClassSession` (below) carries the actual
/// dated instants. Facility-scoped (denormalized from `ClassBatch`), RLS.
model ScheduleSlot {
  id           String   @id @default(uuid())
  facilityId   String
  classBatchId String
  /// 0 = Sunday .. 6 = Saturday (JS `Date#getDay()` convention).
  weekday      Int
  /// `HH:mm`, 24h, ICT wall-clock.
  startTime    String
  /// `HH:mm`, 24h, ICT wall-clock.
  endTime      String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  classBatch    ClassBatch     @relation(fields: [classBatchId], references: [id])
  classSessions ClassSession[]

  @@index([facilityId])
  @@index([classBatchId])
}

/// One scheduled class meeting, auto-generated (WF-P2-01) for every date in
/// `[ClassBatch.startDate, endDate]` whose weekday matches a `ScheduleSlot`.
/// `startTime`/`endTime` are real dated instants (timestamptz, ICT) — unlike
/// `ScheduleSlot`'s wall-clock-only pattern — so room/time-conflict and
/// attendance-gate (later phase) checks can compare instants directly.
/// Facility-scoped (denormalized from `ClassBatch`), RLS.
model ClassSession {
  id             String        @id @default(uuid())
  facilityId     String
  classBatchId   String
  scheduleSlotId String?
  /// The session's calendar day, stored as ICT midnight (so `re-generate`
  /// idempotency and the docs/19 §5 "bucket by ICT month" gate compare a
  /// stable instant, not a naive date string).
  sessionDate    DateTime      @db.Timestamptz(3)
  startTime      DateTime      @db.Timestamptz(3)
  endTime        DateTime      @db.Timestamptz(3)
  status         SessionStatus @default(planned)
  isMakeup       Boolean       @default(false)
  /// T2-I (`classSession.assignUnit`, docs/26 WF-P2-01 remainder): the
  /// curriculum unit taught in this session. Nullable — not every session has
  /// a unit assigned yet. References the GLOBAL `CurriculumUnit` catalog (no
  /// facilityId on that side), so no RLS cross-check applies to this FK.
  curriculumUnitId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  classBatch             ClassBatch             @relation(fields: [classBatchId], references: [id])
  scheduleSlot           ScheduleSlot?          @relation(fields: [scheduleSlotId], references: [id])
  curriculumUnit         CurriculumUnit?        @relation(fields: [curriculumUnitId], references: [id])
  attendances            Attendance[]
  qualitativeAssessments QualitativeAssessment[]
  sessionEvidence        SessionEvidence?

  // Re-generate idempotency (WF-P2-01 acceptance: "re-generate không nhân
  // đôi"): at most one session per (classBatch, slot, calendar day).
  @@unique([classBatchId, scheduleSlotId, sessionDate])
  @@index([facilityId])
  @@index([classBatchId])
  @@index([scheduleSlotId])
  @@index([facilityId, sessionDate])
  @@index([curriculumUnitId])
}

// ---------------------------------------------------------------------------
// T2-I — Exercise foundation (docs/26 WF-P2-04, TL19 §1/§3, QĐ 0021/0022).
// ---------------------------------------------------------------------------

/// Curriculum "bài học" catalog (docs/19 §1). **GLOBAL, no `facilityId`, no
/// RLS** (QĐ 0021) — the curriculum is shared system-wide across every
/// facility, unlike `Course`/`Room`/`ClassBatch` above.
model CurriculumUnit {
  id         String   @id @default(uuid())
  program    Program
  level      Int
  monthIndex Int
  unitType   UnitType
  title      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  classSessions ClassSession[]
  exercises     Exercise[]

  @@index([program, level, monthIndex])
}

/// PDF-based exercise (docs/19 §3, WF-P2-04): `basePdfRef` is a `BlobStorage`
/// key (@cmc/storage), not a DB-stored file. **GLOBAL, no `facilityId`, no
/// RLS** (QĐ 0022) — one catalog of exercises per curriculum unit, shared
/// system-wide like `CurriculumUnit` above (open-tier gating per-student
/// happens in T2-II, not here). `createdById` is a plain scalar (references
/// AppUser.id, arriving with the HR/identity phase — same deferral as
/// `ClassBatch.teacherId`).
model Exercise {
  id               String         @id @default(uuid())
  curriculumUnitId String
  type             ExerciseType
  basePdfRef       String
  maxScore         Int            @default(10)
  starReward       Int            @default(10)
  status           ExerciseStatus @default(draft)
  createdById      String
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  curriculumUnit CurriculumUnit @relation(fields: [curriculumUnitId], references: [id])
  submissions    Submission[]

  // One exercise per (unit, type) — TL19 §3 "unique [curriculumUnitId, type]".
  @@unique([curriculumUnitId, type])
  @@index([curriculumUnitId])
}

// ---------------------------------------------------------------------------
// T2-II — Submission + grading + stars (docs/26 WF-P2-03/05/06, TL19 §3/§6,
// ADR 0038, docs/decisions/0042). Unlike Exercise/CurriculumUnit (global
// catalogs above), Submission/FinalGrade/StarTransaction are child-produced
// or child-attributed data tied to one facility — **facilityId + RLS** on
// all three (docs/decisions/0042).
// ---------------------------------------------------------------------------

/// Student's PDF-annotation submission for one Exercise (docs/19 §3,
/// WF-P2-05). One row per (exerciseId, studentId) — re-drafting updates the
/// SAME row (`version` increments), it never creates a second Submission.
model Submission {
  id              String           @id @default(uuid())
  facilityId      String
  exerciseId      String
  studentId       String
  /// The student's PDF annotation overlay (docs/19 §3) — capped at 1MB by the
  /// application (`submission.saveDraft`), not enforced at the DB layer.
  annotationLayer Json
  answerText      String?
  version         Int              @default(1)
  status          SubmissionStatus @default(draft)
  submittedAt     DateTime?        @db.Timestamptz(3)
  /// Addition beyond the phase-03 field list: the instant `submission.grade`
  /// last scored this row. Needed to bucket a (re)grade into the correct
  /// `FinalGrade.period` (ICT month) without conflating it with
  /// `submittedAt` — a regrade must re-bucket by WHEN IT WAS GRADED, not by
  /// the original submission time.
  gradedAt        DateTime?        @db.Timestamptz(3)
  score           Int?
  gradedById      String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  exercise Exercise @relation(fields: [exerciseId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([exerciseId, studentId])
  @@index([facilityId])
  @@index([studentId])
  @@index([exerciseId])
}

/// Per-(student, class, ICT-month) grade aggregate — the phase-03 spec's
/// `Grade`/`FinalGrade` collapsed into the single-table option it names
/// ("or a single FinalGrade keyed (studentId, classBatchId, period)").
/// `period` = ICT calendar month (`YYYY-MM`, `ictMonthOf`) of the triggering
/// grade — the SAME monthly bucket `Attendance`'s rate uses (docs/19 §5/§6),
/// so one `computeFinalGrade` call combines a student's exercise scores and
/// attendance rate for the same calendar month. **Documented assumption**
/// (TL19 §6 does not pin an exact period grain or weighting — see
/// `@cmc/domain-grading`).
model FinalGrade {
  id           String   @id @default(uuid())
  facilityId   String
  studentId    String
  classBatchId String
  /// ICT calendar month, `YYYY-MM`.
  period       String
  score        Float
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  student    Student    @relation(fields: [studentId], references: [id])
  classBatch ClassBatch @relation(fields: [classBatchId], references: [id])

  @@unique([studentId, classBatchId, period])
  @@index([facilityId])
  @@index([classBatchId])
}

/// Append-mindset star ledger (docs/19 §6, WF-P2-06): `homework_completed`
/// awards `Exercise.starReward` exactly once per graded Submission —
/// idempotent across regrades. `submission.grade` checks
/// `(refType='submission', refId=submissionId, type='homework_completed')`
/// before inserting; a hand-added partial unique index in this phase's
/// migration backstops the same invariant at the DB layer (same pattern as
/// the hand-added `enrollment_active_reserved_unique` index, H2 remediation).
model StarTransaction {
  id         String      @id @default(uuid())
  facilityId String
  studentId  String
  type       StarTxnType
  amount     Int
  refType    String?
  refId      String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id])

  @@index([facilityId])
  @@index([studentId])
}

/// T1 attendance (docs/19 §5, WF-P2-02): one row per (ClassSession,
/// Enrollment) — UPSERT on re-mark (last-write-wins, `attendance.mark`/
/// `markAll` re-write `status`/`markedById`/`markedAt` on conflict rather than
/// erroring), never deleted (append-only-ish audit trail; `cmc_app` has no
/// DELETE grant on this table — see the migration). `studentId` is
/// denormalized from `Enrollment.studentId` at mark-time for read
/// convenience (attendance history stays queryable by student even if the
/// Enrollment row's own studentId can never actually change in practice).
/// `markedById` is a plain scalar (references AppUser.id, arriving with the
/// HR/identity phase — same deferral as `ClassBatch.teacherId`).
model Attendance {
  id           String           @id @default(uuid())
  facilityId   String
  classSessionId String
  enrollmentId String
  studentId    String
  status       AttendanceStatus
  markedById   String
  markedAt     DateTime         @db.Timestamptz(3)
  /// P3-I: real FK to AppUser (nullable — backfill; old rows keep plain scalar).
  markedByAppUserId String?

  classSession     ClassSession @relation(fields: [classSessionId], references: [id])
  enrollment       Enrollment   @relation(fields: [enrollmentId], references: [id])
  student          Student      @relation(fields: [studentId], references: [id])
  markedByAppUser  AppUser?     @relation(fields: [markedByAppUserId], references: [id])

  @@unique([classSessionId, enrollmentId])
  @@index([facilityId])
  @@index([studentId])
}

/// Atomic per-(facility, program, year) sequence for the class-code format
/// (QĐ 0036) — unlike `ReceiptCodeCounter`, `facilityId` here is a REAL
/// facility id (not a global sentinel), so Postgres RLS applies normally (the
/// upsert runs inside `withFacility`, whose GUC matches the row being written).
model ClassBatchCodeCounter {
  id         String   @id @default(uuid())
  facilityId String
  program    Program
  year       Int
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([facilityId, program, year])
  @@index([facilityId])
}

/// Phone-based OTP login for the LMS (parent/student). System-wide, not
/// facility-scoped — a phone is not bound to one facility.
model LoginOtp {
  id        String         @id @default(uuid())
  phone     String
  /// Hashed OTP (M11/H5 remediation): `${salt}:${sha256Hex}` — see
  /// apps/api/src/lms-auth/otp-hash.ts. The plaintext code is never
  /// persisted.
  codeHash  String
  /// H5 remediation: count of failed verify attempts against this row.
  /// Reaching MAX_OTP_VERIFY_ATTEMPTS (lms-auth/router.ts) locks it
  /// (status -> expired) so it can never be retried further, even within TTL.
  attempts  Int            @default(0)
  status    LoginOtpStatus @default(pending)
  expiresAt DateTime       @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([phone])
}

model EmailOutbox {
  id        String            @id @default(uuid())
  to        String
  transport EmailTransport
  status    EmailOutboxStatus @default(pending)
  payload   Json
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// T3 — Assessment (WF-P2-07) + Session evidence + Consent (WF-P2-08 + C2).
// All three are facility-scoped + RLS (ADR 0042). Guardian.photoConsent
// columns are added via ALTER TABLE in the T3 migration (no new model there).
// ---------------------------------------------------------------------------

/// AI-drafted or teacher-authored qualitative assessment for a student.
/// `status`: draft (AI produced, awaiting teacher review) → confirmed (teacher
/// approved and optionally edited) | discarded (teacher rejected outright).
/// `draftedBy`: 'ai' when `assessment.draftComment` generated it, 'teacher'
/// if a teacher wrote it directly without the LLM path.
/// One assessment can be session-scoped (`classSessionId`) OR period-scoped
/// (`period = 'YYYY-MM'`) for monthly report cards — at least one must be set
/// (enforced at the application layer, not the DB).
/// Facility-scoped, RLS.
model QualitativeAssessment {
  id             String    @id @default(uuid())
  facilityId     String
  studentId      String
  classSessionId String?
  /// ICT calendar month `YYYY-MM` for monthly report-card assessments.
  period         String?
  content        String    @default("")
  /// draft | confirmed | discarded
  status         String    @default("draft")
  /// ai | teacher
  draftedBy      String    @default("ai")
  confidence     Float?
  confirmedById  String?
  confirmedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  student       Student       @relation(fields: [studentId], references: [id])
  classSession  ClassSession? @relation(fields: [classSessionId], references: [id])

  @@index([facilityId])
  @@index([studentId, period])
}

/// Teacher-authored evidence record for one class session (summary + optional
/// photos). One row per `classSessionId` (UNIQUE). `internalNote` is
/// staff-only — it MUST NEVER appear in any LMS-facing response (enforced
/// in `session-evidence/router.ts`). Facility-scoped, RLS.
model SessionEvidence {
  id             String    @id @default(uuid())
  facilityId     String
  classSessionId String    @unique
  summary        String    @default("")
  /// Staff-only field. NEVER serialize to LMS responses.
  internalNote   String    @default("")
  /// draft | published
  status         String    @default("draft")
  publishedById  String?
  publishedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  classSession ClassSession        @relation(fields: [classSessionId], references: [id])
  photos       SessionEvidencePhoto[]

  @@index([facilityId])
}

/// One photo attached to a SessionEvidence record. `blobRef` is a @cmc/storage
/// blob key (not a DB-stored file). Photo visibility to parents is gated by
/// `Guardian.photoConsent` (C2). Facility-scoped, RLS.
model SessionEvidencePhoto {
  id                String   @id @default(uuid())
  facilityId        String
  sessionEvidenceId String
  blobRef           String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  sessionEvidence SessionEvidence @relation(fields: [sessionEvidenceId], references: [id])

  @@index([sessionEvidenceId])
}

// ---------------------------------------------------------------------------
// P3-I — HR/identity: AppUser (staff), FacilityNetwork (IP ranges),
// EmployeeCodeCounter (global sequence), TimePunch (clock-in/out, append-only),
// ManualAttendanceTicket (pending|approved|rejected|resubmitted).
// All facility-scoped + RLS except EmployeeCodeCounter (global).
// ---------------------------------------------------------------------------

/// Staff member in a facility, linked to an auth userId. `employeeCode` is
/// auto-generated as `CMC####` via `EmployeeCodeCounter`. Facility-scoped, RLS.
model AppUser {
  id           String   @id @default(uuid())
  facilityId   String
  userId       String   @unique
  email        String   @default("")
  fullName     String   @default("")
  position     String   @default("")
  managerId    String?
  employeeCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  facility         Facility               @relation(fields: [facilityId], references: [id])
  manager          AppUser?               @relation("AppUserManager", fields: [managerId], references: [id])
  subordinates     AppUser[]              @relation("AppUserManager")
  timePunches      TimePunch[]
  tickets          ManualAttendanceTicket[] @relation("AppUserTickets")
  reviewedTickets  ManualAttendanceTicket[] @relation("AppUserReviewer")
  markedAttendances    Attendance[]
  createdReceipts      Receipt[]  @relation("ReceiptCreatedBy")
  approvedReceipts     Receipt[]  @relation("ReceiptApprovedBy")
  taughtBatches        ClassBatch[] @relation("ClassBatchTeacher")
  createdBatches       ClassBatch[] @relation("ClassBatchCreatedBy")

  @@index([facilityId])
}

/// IP ranges (CIDR or single IP) that are allowed for clock-in at a facility.
/// If a facility has active FacilityNetwork rows, callers MUST match one to
/// use `checkInOut.punch`; if there are none, the punch is allowed from any IP
/// (dev-mode open). Facility-scoped, RLS.
model FacilityNetwork {
  id         String   @id @default(uuid())
  facilityId String
  cidr       String
  label      String   @default("")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
}

/// Single-row global sequence for `CMC####` employee codes. Row id=1 is
/// inserted once in the migration; `next` is incremented atomically on each
/// `user.create` call.
model EmployeeCodeCounter {
  id   Int @id @default(1)
  next Int @default(1)
}

/// Clock-in/out record for one staff member at one facility. Append-only:
/// `cmc_app` has no DELETE/UPDATE grant (see migration). Facility-scoped, RLS.
model TimePunch {
  id         String   @id @default(uuid())
  facilityId String
  appUserId  String
  punchAt    DateTime @default(now()) @db.Timestamptz(3)
  method     String
  ip         String?

  facility Facility @relation(fields: [facilityId], references: [id])
  appUser  AppUser  @relation(fields: [appUserId], references: [id])

  @@index([facilityId, appUserId])
}

/// Manual attendance correction ticket. `status` lifecycle:
/// `pending` → `approved` | `rejected` → `resubmitted` (then re-enters the
/// `pending`/`approved`/`rejected` cycle). Approved by the ticket owner's
/// direct manager (anti-self-approve, `manualPunch.approve`).
/// Facility-scoped, RLS.
model ManualAttendanceTicket {
  id           String    @id @default(uuid())
  facilityId   String
  appUserId    String
  ticketDate   DateTime  @db.Timestamptz(3)
  status       String    @default("pending")
  note         String    @default("")
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  facility   Facility @relation(fields: [facilityId], references: [id])
  appUser    AppUser  @relation("AppUserTickets", fields: [appUserId], references: [id])
  reviewedBy AppUser? @relation("AppUserReviewer", fields: [reviewedById], references: [id])

  @@index([facilityId, appUserId])
}
